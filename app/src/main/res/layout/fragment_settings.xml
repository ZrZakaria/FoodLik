<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foodlik_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/foodlik_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/profileSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/foodlik_floating_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/profileInitial"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/foodlik_avatar_circle"
                android:gravity="center"
                android:text="U"
                android:textColor="@color/foodlik_on_primary_container"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="@color/foodlik_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="guest@foodlik.ma"
                    android:textColor="@color/foodlik_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_account"
            android:textColor="@color/foodlik_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/customerPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/foodlik_floating_pill"
            android:hint="@string/customer_phone"
            android:inputType="phone"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/foodlik_text"
            android:textColorHint="@color/foodlik_text_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_section_delivery"
            android:textColor="@color/foodlik_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/deliveryAddressInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/foodlik_floating_pill"
            android:hint="@string/delivery_address"
            android:inputType="textPostalAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/foodlik_text"
            android:textColorHint="@color/foodlik_text_muted" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/foodlik_action_button"
            android:text="@string/save"
            android:textColor="@color/foodlik_on_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/foodlik_outline_button"
            android:text="@string/logout_button"
            android:textColor="@color/foodlik_text"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
