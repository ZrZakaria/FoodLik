<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foodlik_background"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/historyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/foodlik_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historySectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/history_section_today"
            android:textColor="@color/foodlik_text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/historyHeader"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:id="@+id/emptyHistoryState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No order yet"
            android:textColor="@color/foodlik_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/browseFoodButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start Browsing"
            android:backgroundTint="@color/foodlik_primary"
            android:textColor="@color/foodlik_on_primary" />
    </LinearLayout>

</RelativeLayout>
